# App Configuration
APP_NAME="AI Viva Voce System"
DEBUG=true
API_V1_STR=/api

# Security / Auth
SECRET_KEY=change-this-to-a-super-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite (async dev):
DATABASE_URL=sqlite+aiosqlite:///./viva.db
# For PostgreSQL (prod):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/viva_db

# CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM settings (Phase 2+)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
